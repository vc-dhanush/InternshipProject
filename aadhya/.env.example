# MongoDB (local or Atlas mongodb+srv://…)
MONGODB_URI=mongodb://127.0.0.1:27017/aadhya
PORT=5000

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# URLs (on Vercel use https://YOUR-APP.vercel.app for both)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Optional email (forgot password). Leave blank to log reset links in the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Aadhya <no-reply@example.com>

# App
NODE_ENV=development
HOST=127.0.0.1
UPLOAD_DIR=uploads
